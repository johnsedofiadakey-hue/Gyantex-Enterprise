# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
functions/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# firebase functions build output
functions/lib

# firebase local state / debug logs
.firebase
firebase-debug.log
firebase-debug.*.log

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example files are intentionally kept — they're templates, not secrets)
.env*
!.env.example
!functions/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
