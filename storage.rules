rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Product photography: public to view, owner-only to upload/replace/delete.
    // Split from one `allow write` because `request.resource` (the file
    // being uploaded) doesn't exist on a delete — a single rule checking
    // request.resource.size on every write silently denied every delete.
    match /products/{allPaths=**} {
      allow read: if true;
      allow create, update: if request.auth != null
                   && (request.auth.token.role == 'owner' || request.auth.token.admin == true)
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                   && (request.auth.token.role == 'owner' || request.auth.token.admin == true);
    }
  }
}
