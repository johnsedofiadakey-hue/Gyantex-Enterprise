# Copy this file to .env.local and fill in real values. Never commit .env.local.

# WhatsApp Business number customers are sent to from the checkout page's
# "Complete Order via WhatsApp" fallback. Include country code, digits only
# (e.g. 233246860173 for a Ghana number).
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Support email shown in the footer, contact page, and policy pages.
# Defaults to hello@gyantexenterprise.com if unset.
NEXT_PUBLIC_SUPPORT_EMAIL=
