# Copy this file to .env and fill in real values (or set the equivalents with
# `firebase functions:config:set`). Never commit the real .env.

# Paystack — required to take real payments. Without this set, checkout falls
# back to a mock authorization URL and the webhook skips signature
# verification (fine for local dev only — never deploy without it).
PAYSTACK_SECRET_KEY=

# mNotify — sends the order-confirmed, delivery-status, and POS receipt SMS.
# Skipped silently if unset. Get this from mNotify → Settings → API Keys.
MNOTIFY_API_KEY=
# The sender name customers see as the SMS "from" — must be the exact name
# approved in your mNotify dashboard (11 characters max). Defaults to
# "GYANTEX" if unset.
MNOTIFY_SENDER_ID=GYANTEX

# SMTP — sends the order-confirmed email receipt. Skipped silently if unset.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Gyantex Enterprise <orders@gyantexenterprise.com>"

# Your storefront's public URL (no trailing slash) — used to add a
# "track your order" link to the confirmation SMS and email. Left out of
# messages entirely if unset.
SITE_URL=https://gyantex.com

# Phone number that receives a "new paid order" SMS via mNotify. Defaults to
# Gyantex's own line if unset.
ADMIN_NOTIFY_PHONE=233246860173
